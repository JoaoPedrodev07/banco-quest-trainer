# Copie para `backend/.env` e ajuste. O settings é FAIL-CLOSED (ADR-020):
# sem nada configurado ele assume produção — e derruba o processo se faltar
# SECRET_KEY. Para desenvolver, o mínimo é DJANGO_DEBUG=true.

# --- Desenvolvimento local -------------------------------------------------
# Liga DEBUG (CORS de loopback liberado, BrowsableAPI, sem HTTPS forçado).
DJANGO_DEBUG=true

# --- Obrigatórias em produção ----------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
#DJANGO_SECRET_KEY=
# Domínios que servem a API, separados por vírgula.
#DJANGO_ALLOWED_HOSTS=api.seudominio.com.br
# Origem do frontend publicado (sem barra final).
#CORS_ALLOWED_ORIGINS=https://app.seudominio.com.br
# Necessário para o login do admin atrás de proxy HTTPS.
#DJANGO_CSRF_TRUSTED_ORIGINS=https://api.seudominio.com.br

# --- Banco -------------------------------------------------------------------
# Sem DATABASE_URL usa SQLite local (só para desenvolvimento — não aguenta
# escrita concorrente de multi-worker). Produção: Postgres.
#DATABASE_URL=postgres://usuario:senha@localhost:5432/focobb

# --- Cache / rate limit ------------------------------------------------------
# Com Redis o throttle conta entre workers e sobrevive a restart.
#REDIS_URL=redis://localhost:6379/0
# 0 = usa REMOTE_ADDR (imune a spoof de X-Forwarded-For). Atrás de 1 proxy: 1.
#DJANGO_NUM_PROXIES=0
#API_THROTTLE_ANON=240/min

# --- Observabilidade ---------------------------------------------------------
#SENTRY_DSN=
#SENTRY_TRACES_SAMPLE_RATE=0
#DJANGO_LOG_LEVEL=INFO

# --- Diversos ----------------------------------------------------------------
#DJANGO_SECURE_SSL_REDIRECT=true
#DJANGO_HSTS_SECONDS=31536000
#INGEST_DIR=
